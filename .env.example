# ─── whatsbot-v1 — environment template ─────────────────────────────────────
# Copy to .env and fill in your values.

# Your WhatsApp number (country code, digits only)
OWNER_NUMBER=2348000000000

# Bot display name
BOT_NAME=WhatsBot V1

# Command prefix
PREFIX=.

# ─── Local database (standalone mode) ───────────────────────────────────────
# PostgreSQL connection string used for session backup, group settings,
# privacy settings, and message persistence.
DATABASE_URL=postgresql://user:password@localhost:5432/whatsbot

# ─── Remote client mode (optional) ──────────────────────────────────────────
# Set these to register this bot with a WhatsBot V1 control plane instead of
# (or in addition to) running fully standalone. Issue credentials from the
# control plane's admin dashboard: POST /api/admin/clients.
# SESSION_ID=8F42K91X
# SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTROL_URL=http://your-control-server:3000

# Optional: forward incoming messages to a webhook as JSON
# WEBHOOK_URL=https://example.com/hooks/whatsapp

# ─── Automation ─────────────────────────────────────────────────────────────
# AUTO_READ=false
# AUTO_REACT=true
# AUTO_TYPING=false
# AUTO_STATUS_VIEW=false
# AUTO_STATUS_REACT=false
# ANTI_CALL=false
# AUTO_BIO=false
# AUTO_CHATBOT=false

# ─── Privacy Mode ───────────────────────────────────────────────────────────
# PRIVACY_MODE=false
# PRIVACY_LEVEL=normal          # normal | privacy | custom
# PRIVACY_SUPPRESS_TYPING=false
# PRIVACY_PAUSE_AUTOREPLY=false

# ─── Anti-abuse ─────────────────────────────────────────────────────────────
# RATE_MSG_PER_MIN=20
# RATE_MSG_PER_HOUR=200
# RATE_MSG_PER_DAY=500
# RATE_NEW_RECIPIENTS_PER_DAY=50
# KILL_SWITCH=false

# ─── Local health endpoint ──────────────────────────────────────────────────
# Binds to 127.0.0.1 by default. Set API_HOST=0.0.0.0 to expose it (e.g. for
# Docker health checks / load balancers).
# API_PORT=3000
# API_HOST=127.0.0.1
